---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { site } from "@/data/site";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = site.title,
  description = site.description,
  ogImage = site.ogImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, site.url);
const ogImageURL = new URL(ogImage, site.url);
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured Data: Person -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: site.person.fullName,
        jobTitle: site.person.role,
        affiliation: {
          "@type": "Organization",
          name: site.person.party,
        },
        url: site.url,
        sameAs: Object.values(site.social),
      })}
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Development Bar (skrytý, aktivace: __devbar() v console) -->
    <div id="dev-bar">
      <span class="dev-label">DEV</span>
      <div class="dev-themes">
        <button class="dev-theme-btn active" data-theme="duvera" onclick="window.__setTheme('duvera')">
          <span class="dev-swatch" style="background:#2E7AB8"></span>Důvěra
        </button>
        <button class="dev-theme-btn" data-theme="clovek" onclick="window.__setTheme('clovek')">
          <span class="dev-swatch" style="background:#2D6A4F"></span>Člověk
        </button>
        <button class="dev-theme-btn" data-theme="majak" onclick="window.__setTheme('majak')">
          <span class="dev-swatch" style="background:#B45309"></span>Maják
        </button>
        <button class="dev-theme-btn" data-theme="facebook" onclick="window.__setTheme('facebook')">
          <span class="dev-swatch" style="background:#26348B; box-shadow: 0 0 0 2px #F4F400;"></span>FB as-is
        </button>
      </div>
      <span class="dev-info" id="dev-bar-info">tema: duvera</span>
      <button class="dev-close" onclick="window.__devbar(false)">&times; zavřít</button>
    </div>

    <script is:inline>
      // Theme switcher
      window.__setTheme = function(name) {
        document.documentElement.setAttribute('data-theme', name);
        localStorage.setItem('jb-theme', name);
        // Update dev bar buttons
        document.querySelectorAll('#dev-bar .dev-theme-btn').forEach(function(btn) {
          btn.classList.toggle('active', btn.getAttribute('data-theme') === name);
        });
        var info = document.getElementById('dev-bar-info');
        if (info) info.textContent = 'tema: ' + name;
      };

      // Dev bar toggle
      window.__devbar = function(show) {
        var bar = document.getElementById('dev-bar');
        if (!bar) return;
        if (typeof show === 'undefined') show = !bar.classList.contains('active');
        bar.classList.toggle('active', show);
        if (show) console.log('%c[DEV BAR] Aktivní. Přepínej témata kliknutím.', 'color: #f59e0b; font-weight: bold;');
      };

      // Restore saved theme (only if dev bar was used before)
      (function() {
        var saved = localStorage.getItem('jb-theme');
        if (saved && saved !== 'duvera') {
          window.__setTheme(saved);
        }
      })();
    </script>
  </body>
</html>
